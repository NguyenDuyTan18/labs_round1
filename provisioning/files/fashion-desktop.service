[Unit]
Description=Separate lab XFCE desktop (preserves platform VNC on port 5900)
After=network.target

[Service]
Type=simple
User=user-access
Group=user-access
WorkingDirectory=/home/user-access
Environment=HOME=/home/user-access
Environment=XDG_RUNTIME_DIR=/run/fashion-desktop
RuntimeDirectory=fashion-desktop
RuntimeDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/bin/tigervncserver -list -cleanstale
ExecStart=/usr/bin/tigervncserver -fg -autokill yes :{{ fashion_vnc_display | default(9) | int }} -rfbport {{ fashion_vnc_port | default(5901) | int }} -localhost yes -SecurityTypes VncAuth -PasswordFile /home/user-access/.vnc/passwd -geometry 1440x900 -depth 24 -xstartup /usr/local/libexec/fashion-xfce
ExecStop=/usr/bin/tigervncserver -kill :{{ fashion_vnc_display | default(9) | int }}
Restart=on-failure
RestartSec=3
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
